# STRATA prototype - copy to .env. All optional; everything runs keyless.
STRATA_MODE=live            # live | replay
STRATA_STORE=file           # file | postgres (postgres not built in this pass)
STRATA_SEED=seed_dev
LLM_PROVIDER=none           # none = deterministic cited templates + TF-IDF retrieval
LLM_MODEL=
EMBED_PROVIDER=none
EMBED_MODEL=
EMBED_DIM=1536
LLM_MAX_CALLS_PER_HOUR=60
SIM_NOW=2026-10-09T09:00:00+05:30
ENGINE_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1

# ---- night build: auth, email, assistant (all optional; keyless demo still works) ----
APP_URL=http://localhost:3000          # used in email links
STRATA_AUTH_SECRET=                    # long random string; auto-generated into data/store/.auth_secret if empty
STRATA_ADMIN_KEY=                      # enables POST /admin/companies (we assign company join codes); empty = disabled
STRATA_DEMO_LOGINS=1                   # 1 = show one demo login per role on the sign-in page
# Email (Gmail + app password). Empty = mail goes to the in-app outbox and sign-up codes are shown on screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                             # your.address@gmail.com
SMTP_PASSWORD=                         # 16-char Google app password (not your Gmail password)
SMTP_FROM=
SMTP_FROM_NAME=STRATA
# Assistant chatbot (Gemini). Both fields are required for the Gemini path; empty = deterministic cited answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # fast + reliable on the free tier; gemini-3.5-flash is slower but stronger
